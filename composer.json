{
    "name": "connysjoblom/advent",
    "description": "My Advent of Code Solutions.",
    "keywords": [
        "advent-of-code",
        "laravel-zero",
        "cli"
    ],
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Conny Sjöblom",
            "email": "conny@sjoblom.io"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-gmp": "*",
        "illuminate/http": "^13.0",
        "illuminate/translation": "^13.0",
        "illuminate/validation": "^13.0",
        "laravel-zero/framework": "^13.0",
        "nesbot/carbon": "^3.14"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6.15",
        "pestphp/pest": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --parallel",
        "lint": "pint",
        "analyse": "phpstan analyse",
        "check": [
            "@composer validate --strict",
            "pint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "advent"
    ]
}
